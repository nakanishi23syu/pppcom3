{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "FellowOakDicom": "Debug"
    }
  },

  // docs/CONTRACT.md 7章の開発用デフォルト接続文字列（ローカルDocker上のPostgreSQL）。
  // C-FIND/C-MOVE SCPが登録済みStudy/Series/Sopを検索するために使う。
  "ConnectionStrings": {
    "Dicom": "Host=localhost;Port=5432;Database=dicomtool;Username=dicomtool;Password=dicomtool_dev_password"
  },

  // ローカル開発時、このPC上でOrthanc(REST:8042, DICOM:4242)が動いている前提のデフォルト値。
  // docs/dicom-testing-tools/orthanc.md参照。
  "RemoteAeTitles": {
    "ORTHANC": "127.0.0.1:4242"
  }
}
