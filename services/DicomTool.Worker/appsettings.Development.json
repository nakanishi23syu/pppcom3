{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },

  // docs/CONTRACT.md 7章の開発用デフォルト接続文字列（ローカルDocker上のPostgreSQL）。
  // 環境変数 ConnectionStrings__Dicom で上書き可能（本番相当のVM等に向き先を変える場合はこちら。
  // ASP.NET Coreの設定システムは「セクション名__キー名」の環境変数を階層構成として自動的に
  // マージするため、appsettings.jsonを書き換えずに接続先を差し替えられる）。
  // ※ .NET標準のJSON構成プロバイダ(Microsoft.Extensions.Configuration.Json)は
  //   JsonCommentHandling.Skipで読み込むため、"//"コメントを書いても構成読み込みは失敗しない。
  "ConnectionStrings": {
    "Dicom": "Host=localhost;Port=5432;Database=dicomtool;Username=dicomtool;Password=dicomtool_dev_password"
  },

  // docs/CONTRACT.md 4章: Temporal Server接続先。開発時はdocker-composeで起動したlocalhost:7233。
  "Temporal": {
    "Address": "localhost:7233"
  }
}
