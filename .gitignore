# ===== .NET =====
bin/
obj/
publish/
*.user
*.suo

# ===== Node / Nuxt =====
node_modules/
.nuxt/
.output/
.nitro/
.cache/
dist/

# ===== Blazor =====
**/wwwroot/_framework/

# ===== ローカル実行時データ（DICOM実ファイル・SQLite等） =====
infra/data/dicom-storage/*
!infra/data/dicom-storage/.gitkeep
infra/data/dicom-incoming/*
!infra/data/dicom-incoming/.gitkeep
*.db
*.db-shm
*.db-wal

# ===== E2Eテスト(tests/e2e/)の実行時出力 =====
# Playwrightのスクリーンショット等。実行するたびに生成される使い捨てファイルのため、
# リポジトリには含めない（tests/e2e/README.md参照）。
tests/e2e/output/
__pycache__/
*.pyc
venv/
.venv/

# ===== tools/ 配下の各ツールの実行時出力 =====
# tools/はツールごとにサブフォルダを作る方針（例: tools/dicom_test_data_generator/）。
# 各ツールのoutput/フォルダは生成される使い捨てデータのため、深さを問わず除外する。
tools/**/output/

# ===== 環境設定・秘密情報 =====
.env
.env.*
!.env.example
appsettings.*.local.json

# VMへのデプロイ用WinSCPスクリプト（VMのログインパスワードが平文で入っている）
deploy.txt

# ===== IDE =====
.vs/
.vscode/*
!.vscode/extensions.json
.idea/
*.swp

# ===== Claude Code サブエージェント用worktree =====
.claude/worktrees/

# ===== OS =====
Thumbs.db
.DS_Store
